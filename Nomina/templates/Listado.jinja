{% extends "index.jinja" %}

{% block titulo %}
<title>Listado de Nómina</title>
{% endblock titulo %}

{% block body %}

<div class="container mt-4">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold">Listado de Nómina</h1>
            <p class="text-muted">
                Aquí puedes visualizar los registros almacenados en el sistema.
            </p>
        </div>

        <div>
            <a href="/Agregar_Nomina" class="btn btn-primary">
                + Agregar Registro
            </a>
        </div>

    </div>

    <!-- Tarjeta -->
    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            Registros de Empleados
        </div>

        <div class="card-body">

            <!-- Tabla -->
            <div class="table-responsive">

                <table class="table table-striped table-hover align-middle">

                    <thead class="table-dark">

                        <tr>
                            <th>ID</th>
                            <th>Empleado</th>
                            <th>Cargo</th>
                            <th>Sueldo</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>

                    </thead>

                    <tbody>

                        <!-- Datos de ejemplo -->
                        <tr>
                            <td>1</td>
                            <td>Juan Pérez</td>
                            <td>Administrador</td>
                            <td>$850</td>
                            <td>
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            </td>
                            <td>

                                <a href="#" class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a href="#" class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>

                            </td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>María López</td>
                            <td>Contadora</td>
                            <td>$920</td>
                            <td>
                                <span class="badge bg-success">
                                    Activo
                                </span>
                            </td>
                            <td>

                                <a href="#" class="btn btn-warning btn-sm">
                                    Editar
                                </a>

                                <a href="#" class="btn btn-danger btn-sm">
                                    Eliminar
                                </a>

                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

{% endblock body %}